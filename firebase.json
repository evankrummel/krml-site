{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/l",
        "destination": "/lost",
        "type": 301
      },
      {
        "source": "/found",
        "destination": "/lost",
        "type": 301
      }
    ]

  }
}
